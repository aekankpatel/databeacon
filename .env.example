# ---- LLM provider -------------------------------------------------------
# cloudflare (default) | groq | openai (any OpenAI-compatible server) | scripted (offline demo)
DATABEACON_LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (primary; free tier: 10,000 neurons/day, resets 00:00 UTC)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# DATABEACON_MODEL=@cf/openai/gpt-oss-120b      (default; must support tool calling)
# Behind an egress proxy that injects the Authorization header, leave the token empty and set:
# DATABEACON_INJECTED_AUTH=1

# Free-tier guard: Cloudflare calls stop once this many neurons are used today (UTC)
DATABEACON_CLOUDFLARE_DAILY_NEURONS=9000
# Workers AI defaults to 256 output tokens - too few for a reasoning model
DATABEACON_MAX_OUTPUT_TOKENS=4096
# DATABEACON_REASONING_EFFORT=low               (low | medium | high; lower = fewer neurons)

# Optional fallback provider when Cloudflare fails or the neuron budget is spent
# DATABEACON_FALLBACK_PROVIDER=groq
# GROQ_API_KEY=
# DATABEACON_FALLBACK_MODEL=openai/gpt-oss-120b

# Local / other OpenAI-compatible server, e.g. Ollama
# DATABEACON_LLM_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# DATABEACON_MODEL=qwen2.5:14b

# ---- Agent budgets / stopping conditions -------------------------------
DATABEACON_MAX_ITERATIONS=3
DATABEACON_MAX_TOOL_CALLS=24
DATABEACON_MAX_STEPS_PER_ITERATION=8

# ---- Sandbox limits -----------------------------------------------------
DATABEACON_SQL_TIMEOUT_S=15
DATABEACON_SQL_MAX_ROWS=5000
DATABEACON_MAX_UPLOAD_MB=200

# ---- MCP transport: inprocess (fast) | stdio (servers as subprocesses) --
DATABEACON_MCP_TRANSPORT=inprocess

# ---- Observability ------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   (needs opentelemetry-exporter-otlp)
# DATABEACON_OTEL_CONSOLE=1
