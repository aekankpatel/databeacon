# ---- LLM provider -------------------------------------------------------
# cloudflare (default) | groq | openai (any OpenAI-compatible server) | scripted (offline demo)
DATABEACON_LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (free tier: 10,000 neurons/day)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional model override (must support tool calling)
# DATABEACON_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Groq (alternative)
# GROQ_API_KEY=
# DATABEACON_MODEL=openai/gpt-oss-120b

# Local / other OpenAI-compatible server, e.g. Ollama
# DATABEACON_LLM_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# DATABEACON_MODEL=qwen2.5:14b

# ---- Agent budgets / stopping conditions -------------------------------
DATABEACON_MAX_ITERATIONS=3
DATABEACON_MAX_TOOL_CALLS=24
DATABEACON_MAX_STEPS_PER_ITERATION=8

# ---- Sandbox limits -----------------------------------------------------
DATABEACON_SQL_TIMEOUT_S=15
DATABEACON_SQL_MAX_ROWS=5000
DATABEACON_MAX_UPLOAD_MB=200

# ---- MCP transport: inprocess (fast) | stdio (servers as subprocesses) --
DATABEACON_MCP_TRANSPORT=inprocess

# ---- Observability ------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   (needs opentelemetry-exporter-otlp)
# DATABEACON_OTEL_CONSOLE=1
